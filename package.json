{
  "name": "@ctrl/utorrent",
  "version": "6.4.0",
  "description": "TypeScript api wrapper for utorrent using ofetch",
  "keywords": [
    "typescript",
    "utorrent"
  ],
  "homepage": "https://utorrent.ep.workers.dev",
  "license": "MIT",
  "author": "Scott Cooper <scttcper@gmail.com>",
  "repository": "scttcper/utorrent",
  "files": [
    "dist/src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/src/index.js",
  "typings": "./dist/src/index.d.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "lint": "oxlint . && oxfmt --check",
    "lint:fix": "oxlint . --fix && oxfmt",
    "prepare": "pnpm run build",
    "build": "tsc",
    "build:docs": "typedoc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ctrl/magnet-link": "^4.3.0",
    "@ctrl/shared-torrent": "^6.5.1",
    "@ctrl/torrent-file": "^4.5.0",
    "cookie-es": "^3.0.1",
    "form-data-encoder": "^4.1.0",
    "node-fetch-native": "^1.6.7",
    "ofetch": "^1.5.1",
    "type-fest": "^5.5.0",
    "ufo": "^1.6.3",
    "uint8array-extras": "^1.5.0"
  },
  "devDependencies": {
    "@ctrl/oxlint-config": "1.4.2",
    "@sindresorhus/tsconfig": "8.1.0",
    "@types/node": "25.5.0",
    "oxfmt": "0.41.0",
    "oxlint": "1.56.0",
    "typedoc": "0.28.18",
    "typescript": "6.0.2",
    "vitest": "4.1.1"
  },
  "release": {
    "branches": [
      "master"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.32.1"
}
